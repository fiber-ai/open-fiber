# Your Fiber AI API key. Get one at https://fiber.ai/app/api
FIBER_API_KEY=your_fiber_api_key_here

# A real, pre-provisioned Fiber API key used only by the E2E test suite (e2e/) to
# authenticate against the live backend — distinct from FIBER_API_KEY above (that one
# is the self-hosted single-tenant fallback used by the app itself). See e2e/global-setup.ts.
E2E_FIBER_API_KEY=your_e2e_fiber_api_key_here

# Optional: a real LinkedIn profile URL the team has explicitly designated for testing
# contact-enrichment reveals. If unset, e2e/search-and-enrich.spec.ts skips that one
# test rather than targeting an arbitrary real person's profile.
E2E_TEST_LINKEDIN_URL=
